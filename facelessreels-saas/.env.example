# ── Base de données ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/facelessreels?schema=public"

# ── Clerk (Authentification) ───────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Stripe (Paiements) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_STARTER=price_...    # 10 crédits
STRIPE_PRICE_PRO=price_...        # 50 crédits
STRIPE_PRICE_UNLIMITED=price_...  # 200 crédits

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── ElevenLabs ─────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=...

# ── Pexels ─────────────────────────────────────────────────────────────────────
PEXELS_API_KEY=...

# ── Supabase Storage (pour stocker l'audio) ───────────────────────────────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# ── Remotion Lambda (rendu vidéo sur AWS) ─────────────────────────────────────
# Région AWS où la fonction Lambda est déployée
REMOTION_AWS_REGION=us-east-1
# Nom de la fonction Lambda (obtenu via: npx remotion lambda functions deploy)
REMOTION_FUNCTION_NAME=remotion-render-4-0-469-mem3008mb-disk2048mb-240sec
# URL du bundle Remotion sur S3 (obtenu via: npx remotion lambda sites create)
REMOTION_SERVE_URL=https://s3.amazonaws.com/remotionlambda-xxx/sites/facelessreels/index.html
# Secret aléatoire pour valider les webhooks de complétion
REMOTION_WEBHOOK_SECRET=your-random-secret-here

# ── AWS (pour Remotion Lambda) ────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
